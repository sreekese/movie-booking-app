{
  "name": "quick-show",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "dev:client": "vite",
    "test:browser:dev": "node scripts/browser-smoke.mjs --dev",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-postgres.mjs",
    "db:admin": "node --env-file-if-exists=.env scripts/provision-admin.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^1.28.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.10",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
