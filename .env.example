# Local development without DATABASE_URL uses SQLite.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=server/data/quickshow.sqlite

# Vercel: required. Use the PostgreSQL provider's pooled connection URL with SSL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional canonical origin. Leave unset to support same-origin Vercel preview URLs.
# APP_ORIGIN=https://your-project.vercel.app

# Vercel Blob public store: required only for image uploads.
# BLOB_READ_WRITE_TOKEN=your-server-only-token

# Local admin provisioning / existing SQLite admin promotion:
# ADMIN_EMAIL=operator@example.com
# ADMIN_NAME=Cinema Administrator
# ADMIN_PASSWORD=set-only-locally-for-db-admin-then-remove
# Never expose any secret using a VITE_ prefix.
